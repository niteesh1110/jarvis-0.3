<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jarvis is idle"
        android:textColor="#00E5FF"
        android:textSize="16sp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/thinkingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:visibility="gone"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/bar1"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp"
            android:background="#00E5FF" />

        <View
            android:id="@+id/bar2"
            android:layout_width="4dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:background="#00E5FF" />

        <View
            android:id="@+id/bar3"
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:background="#00E5FF" />

        <View
            android:id="@+id/bar4"
            android:layout_width="4dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:background="#00E5FF" />

        <View
            android:id="@+id/bar5"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:background="#00E5FF" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/conversationLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </ScrollView>

    <Button
        android:id="@+id/micButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tap to talk to Jarvis" />

    <Button
        android:id="@+id/serviceToggleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Start always-listening (Hey Jarvis)" />

    <Button
        android:id="@+id/bubbleToggleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enable Floating Bubble" />

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter Claude API Key" />

</LinearLayout>
